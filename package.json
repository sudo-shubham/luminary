{
  "name": "luminary",
  "version": "1.4.0",
  "type": "module",
  "description": "Location-aware camera settings, solar ephemeris, and phone compass light-source radar for photographers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "npx serve -l 3000 dist",
    "validate": "node scripts/validate-pwa.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build:android": "npx @bubblewrap/cli build --skipPwaValidation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sudo-shubham/luminary.github.io.git"
  },
  "keywords": [
    "pwa",
    "pwabuilder",
    "trusted-web-activity",
    "photography",
    "solar-ephemeris",
    "camera-settings"
  ],
  "author": "Shubham Patel",
  "license": "MIT",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.79.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "svelte": "^5.59.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
